# Generate with: openssl rand -hex 32
HARMONY_SECRET_KEY=change-me-in-production

# standalone (fully self-hosted) | proxy (relay to Logitech + record everything)
SERVER_MODE=standalone

# Proxy mode only: real upstream IPs, because your DNS override points the names at us.
# Look them up with a resolver that is NOT your override, e.g. `dig @1.1.1.1 svcs.myharmony.com`.
# HARMONY_PROXY_UPSTREAM_IPS={"svcs.myharmony.com":"x.x.x.x","setup.myharmony.com":"y.y.y.y"}

# Extra SANs for the TLS cert (your server's LAN name/IP), JSON list.
# HARMONY_CERT_EXTRA_NAMES=["harmony.lan","192.168.1.10"]

# For root-repointed hubs: rewrite service URLs handed out by Discovery.svc.
# HARMONY_SERVICE_URL_REWRITES={"https://svcs.myharmony.com":"https://harmony.lan"}

# Register hubs that call getProvisionInfo without being known (true/false).
HARMONY_AUTO_REGISTER_HUBS=true

# Log unimplemented requests to /data/captures/*.jsonl (reverse-engineering aid).
HARMONY_CAPTURE_UNKNOWN_REQUESTS=true
# Headers redacted in captures. Set to [] when you need to see token formats.
# HARMONY_CAPTURE_REDACT_HEADERS=["authorization","cookie","set-cookie"]
